# Local environment / secrets — never commit real keys
.env
**/.env
!.env.example

# Python bytecode (can embed previously hardcoded secrets)
__pycache__/
**/__pycache__/
*.py[cod]

# Local SQLite DB (sessions/cookies after key rotation)
*.sqlite3
db.sqlite3
**/db.sqlite3

# Local virtualenvs and uploaded/test media
.venv/
venv/
.verify-venv/
.ci-smoke-venv/
**/media/

# Legacy loose ML copies at package root (canonical artifacts live under review/models/)
Cinesense-main/model.pkl
Cinesense-main/tokenizer.pkl
