# Copy to .env (or run: python bootstrap_env.py) and set a strong secret key.
# Never commit a real key. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
# Deployed hosts/CI: set DJANGO_SECRET_KEY in the platform secret store
# (not in source). Use a new key if any previous key was ever committed.
DJANGO_SECRET_KEY=

# Local development: True. Production: omit or set False (code default is False).
DJANGO_DEBUG=True

# Comma-separated hosts. Local default if unset: localhost,127.0.0.1
# Production: set your real domain(s), e.g. example.com,www.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
